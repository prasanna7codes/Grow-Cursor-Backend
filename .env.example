# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Sentry (Error Monitoring) ────────────────────────────────────────────────
# Get your DSN from: https://sentry.io → Project Settings → Client Keys (DSN)
# Leave blank to disable Sentry (safe for local dev)
SENTRY_DSN=

# ─── BetterStack (Structured Logging) ────────────────────────────────────────
# Get your token from: https://logs.betterstack.com → Source → Node.js
# Leave blank to log to console only (safe for local dev)
BETTERSTACK_TOKEN=

# Identifies which server instance owns auto-compat batches.
# Set to 'render' in Render's environment variables; leave unset (defaults to 'local') on local dev.
# This prevents a local dev server from stealing batches that Render is processing, and vice versa.
RUNNER_ID=local

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── Authentication ───────────────────────────────────────────────────────────
# Strong random secret for signing JWTs (min 32 chars recommended)
JWT_SECRET=replace_with_a_secure_random_string

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes)
# e.g. https://your-app.vercel.app,https://staging.your-app.vercel.app
CLIENT_ORIGIN=https://your-app.vercel.app

# ─── eBay API ─────────────────────────────────────────────────────────────────
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Separate key used specifically for AI fitment generation (can be same key)
OPENAI_FITMENT_API_KEY=
# Max concurrent OpenAI requests (default: 3)
OPENAI_CONCURRENT_REQUESTS=3

# ─── Amazon product-details provider ──────────────────────────────────────────
# Which provider fetchAmazonData uses for template listings / ASIN precheck /
# ASIN directory / compatibility autofill: 'scraperapi' (default) or 'scrapingdog'.
# Rollback = flip this one var back and restart (restart also clears the ASIN cache).
AMAZON_PRODUCT_PROVIDER=scraperapi

# ─── ScraperAPI (Amazon product data) ─────────────────────────────────────────
SCRAPER_API_KEY=
# Max concurrent scraper requests (default: 5)
SCRAPER_API_CONCURRENT=5
# Request timeout in milliseconds (default: 60000)
SCRAPER_API_TIMEOUT_MS=60000
# Max retries per request (default: 2)
SCRAPER_API_MAX_RETRIES=2

# ─── Scrapingdog (Amazon product data) ────────────────────────────────────────
# Key is shared with the Amazon Stock Check feature.
SCRAPINGDOG_API_KEY=
# Max concurrent product-detail requests (default: 5). Keep SMALL: the account
# concurrency cap (~50) is shared with stock check runs (SCRAPINGDOG_CONCURRENT,
# default 40), which can run for days.
SCRAPINGDOG_PRODUCT_CONCURRENT=5
# Request timeout in milliseconds (default: 45000 — short timeouts cause false failures)
SCRAPINGDOG_PRODUCT_TIMEOUT_MS=45000
# Max retries per request (default: 2)
SCRAPINGDOG_PRODUCT_MAX_RETRIES=2

# ─── ImgBB (image hosting) ────────────────────────────────────────────────────
IMGBB_API_KEY=

# ─── ASIN Cache ───────────────────────────────────────────────────────────────
# Enable in-memory ASIN product cache (true/false)
ENABLE_ASIN_CACHE=true
# Cache TTL in seconds (default: 3600 = 1 hour)
ASIN_CACHE_TTL=3600

# ─── API Usage Tracking ───────────────────────────────────────────────────────
ENABLE_API_USAGE_TRACKING=true

# ─── Bulk Processing ──────────────────────────────────────────────────────────
# Number of ASINs processed per batch in bulk operations (default: 5)
BACKEND_BATCH_SIZE=5
