# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Sentry (Error Monitoring) ────────────────────────────────────────────────
# Get your DSN from: https://sentry.io → Project Settings → Client Keys (DSN)
# Leave blank to disable Sentry (safe for local dev)
SENTRY_DSN=

# ─── BetterStack (Structured Logging) ────────────────────────────────────────
# Get your token from: https://logs.betterstack.com → Source → Node.js
# Leave blank to log to console only (safe for local dev)
BETTERSTACK_TOKEN=

# Identifies which server instance owns auto-compat batches.
# Set to 'render' in Render's environment variables; leave unset (defaults to 'local') on local dev.
# This prevents a local dev server from stealing batches that Render is processing, and vice versa.
RUNNER_ID=local

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── Authentication ───────────────────────────────────────────────────────────
# Strong random secret for signing JWTs (min 32 chars recommended)
JWT_SECRET=replace_with_a_secure_random_string

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes)
# e.g. https://your-app.vercel.app,https://staging.your-app.vercel.app
CLIENT_ORIGIN=https://your-app.vercel.app

# ─── eBay API ─────────────────────────────────────────────────────────────────
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Separate key used specifically for AI fitment generation (can be same key)
OPENAI_FITMENT_API_KEY=
# Separate key used for the ASIN precheck eBay Motors title check (falls back to OPENAI_API_KEY)
OPENAI_PRECHECK_API_KEY=
# Max concurrent OpenAI requests (default: 3)
OPENAI_CONCURRENT_REQUESTS=3

# ─── Amazon product-details provider ──────────────────────────────────────────
# Which provider fetchAmazonData uses for template listings / ASIN precheck /
# ASIN directory / compatibility autofill: 'scraperapi' (default) or 'scrapingdog'.
# Rollback = flip this one var back and restart (restart also clears the ASIN cache).
AMAZON_PRODUCT_PROVIDER=scraperapi

# ─── ScraperAPI (Amazon product data) ─────────────────────────────────────────
SCRAPER_API_KEY=
# Max concurrent scraper requests (default: 5)
SCRAPER_API_CONCURRENT=5
# Request timeout in milliseconds (default: 60000)
SCRAPER_API_TIMEOUT_MS=60000
# Max retries per request (default: 2)
SCRAPER_API_MAX_RETRIES=2

# ─── Scrapingdog (Amazon product data) ────────────────────────────────────────
# Key is shared with the Amazon Stock Check feature.
SCRAPINGDOG_API_KEY=
# Max concurrent product-detail requests (default: 60). The account concurrency
# cap is shared with stock check runs (SCRAPINGDOG_CONCURRENT, default 40),
# which can run for days — keep this + that under the plan's cap.
SCRAPINGDOG_PRODUCT_CONCURRENT=60
# Request timeout in milliseconds (default: 45000 — short timeouts cause false failures)
SCRAPINGDOG_PRODUCT_TIMEOUT_MS=45000
# Retry budgets, per error class (see scrapingdogProduct.js).
# Transient infrastructure errors (502/503/408/429, timeouts): these arrive in
# bursts lasting tens of seconds and return in ~290ms, so re-trying is cheap and
# a spaced ladder usually outlives the burst.
SCRAPINGDOG_PRODUCT_MAX_RETRIES_TRANSIENT=4
# Failed scrapes (HTTP 400, and 200-with-no-price). Re-requesting seconds later
# usually reproduces these, so the budget stays small — raising it mostly buys
# credits, not recoveries. 404/410 are permanent and are never re-tried.
SCRAPINGDOG_PRODUCT_MAX_RETRIES_BAD_SCRAPE=2
# Backoff ladder between attempts, jittered +/-40% so a batch that fails
# together does not re-send together (default 2500 / 20000).
SCRAPINGDOG_PRODUCT_RETRY_BASE_MS=2500
SCRAPINGDOG_PRODUCT_RETRY_MAX_MS=20000

# How many ASINs of ONE precheck batch are in flight at once (default: 40).
# Not the account limit — SCRAPINGDOG_PRODUCT_CONCURRENT owns that pool; this
# decides how much of it a single batch may claim.
ASIN_PRECHECK_CONCURRENCY=40
# Comma-separated pauses before each in-run retry sweep of the ASINs that
# failed, so users get a complete result from ONE submission instead of
# resubmitting the same list. Measured on 70 random ASINs: one attempt each
# resolved 63%, a sweep at +45s reached 80%, a third at +165s reached 86%.
# Only failed ASINs are retried, and a fully-successful pass skips the gaps
# entirely. Set empty to disable sweeps.
ASIN_PRECHECK_SWEEP_GAPS_MS=45000,120000

# ─── ImgBB (image hosting) ────────────────────────────────────────────────────
IMGBB_API_KEY=

# ─── ASIN Cache ───────────────────────────────────────────────────────────────
# Enable in-memory ASIN product cache (true/false)
ENABLE_ASIN_CACHE=true
# Cache TTL in seconds (default: 3600 = 1 hour)
ASIN_CACHE_TTL=3600
# Max cached ASINs (default: 10000). The oldest 10% are evicted once the cache
# reaches 70% of this, since node-cache errors on a full cache instead of
# evicting. Entries hold the full scraper response, so this bounds key count,
# not memory.
ASIN_CACHE_MAX_KEYS=10000

# ─── API Usage Tracking ───────────────────────────────────────────────────────
ENABLE_API_USAGE_TRACKING=true

# ─── Bulk Processing ──────────────────────────────────────────────────────────
# Number of ASINs processed per batch in bulk operations (default: 5)
BACKEND_BATCH_SIZE=5


# Sellers crawled in parallel by the SKU Index Sync. Default 4. Lower it if eBay
# starts returning more transient errors under the extra load.
SKU_SYNC_CONCURRENCY=4

# Listings composited in parallel by the Listing Overlays page (preview, submit
# and revert). Default 4. Each slot decodes a full-size eBay image through sharp,
# whose buffers are native memory outside the V8 heap — so this is not bounded by
# --max-old-space-size and does count against the instance's RSS limit. Lower it
# if the service restarts on memory during an overlay run.
LISTING_OVERLAY_CONCURRENCY=4
# ─── eBay Picture Services ────────────────────────────────────────────────────
# Whether templates with NO badge configured still have their pictures uploaded
# to EPS. Default on. Off, those listings keep their Amazon URLs and eBay
# fetches each picture itself at publish time; on, we upload them first and take
# on the window in which a picture sits on EPS with no listing claiming it —
# which is what the export-time refresh and the upload-time re-host exist to
# manage. Set to the literal string false to turn it off; any other value, and
# an unset variable, leave it on.
#
# This is the revert lever for the hosting volume the Media API migration added:
# roughly 300-600 extra uploads per typical batch, each one a download, a sharp
# decode and two eBay round trips.
HOST_ALL_LISTING_IMAGES=true

# Pictures re-hosted in parallel when a whole feed file is moved to another
# seller, or a stale batch is re-downloaded. Default 5, against an eBay ceiling
# of 50 uploads per 5 seconds per user. Each slot holds a downloaded source
# image and its sharp output in native memory, so this multiplies RSS the same
# way LISTING_OVERLAY_CONCURRENCY does.
EBAY_REHOST_CONCURRENCY=5

# Worker threads libvips uses per sharp operation. Default 1, which is also
# sharp's own default on glibc Linux — so on Render this changes nothing today.
# src/index.js pins it anyway because that default is platform-conditional: a
# musl base image or a jemalloc-linked build gets one thread per detected core,
# and inside a container that count is the host's, not the cgroup allocation.
#
# Raise it only if a measurement shows compositing is the bottleneck. Normally
# it is not — a picture's cost is dominated by the source download and the two
# eBay Media API round trips.
SHARP_CONCURRENCY=1

# Seconds' worth of milliseconds the export-time picture refresh may spend
# before it stops and lets the CSV download proceed. Default 60000. Set to 0 to
# remove the limit.
#
# A re-download of an old batch can find every picture in it expired, and each
# one costs a download, a sharp decode and two eBay round trips. Nothing reaches
# the response until the CSV is built, so an over-long refresh looks like a hung
# request and can be cut by the proxy — the operator gets no file at all. Past
# the budget the remaining listings keep the pictures they had and the count is
# reported in the response headers.
IMAGE_REFRESH_BUDGET_MS=60000
